# ============================
# OBRIGATÓRIAS (sem isso não funciona)
# ============================

# Chave da API Groq (Whisper)
GROQ_API_KEY=seu_token_aqui

# Chave secreta para autenticar requisições na API
API_KEY=uma_chave_secreta_qualquer

# Chave da API YouTube Data v3 (https://console.cloud.google.com)
YOUTUBE_API_KEY=sua_chave_youtube_aqui

# ============================
# OPCIONAIS (só cadastre se quiser mudar o padrão)
# ============================

# Porta do servidor (padrão: 3000)
# PORT=3000

# Duração máxima do vídeo em segundos (padrão: 600 = 10min)
# MAX_DURATION=600

# Pasta onde os áudios temporários serão salvos (só local)
# OUTPUT_FOLDER=C:/Users/SeuUser/Downloads/jarvis
